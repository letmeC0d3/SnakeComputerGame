# Supabase URL (from Settings -> API -> Project URL)
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url

# Supabase Anonymous Key (from Settings -> API -> Project API keys -> anon public)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# Supabase Service Role Key (from Settings -> API -> Project API keys -> service_role secret)
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
